# ============================================================
# NexRhythm
# Repository-level .gitignore
# ============================================================

# ------------------------------------------------------------
# OS files
# ------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# ------------------------------------------------------------
# Editors / IDEs
# ------------------------------------------------------------
.idea/
.vscode/
*.iml

# ------------------------------------------------------------
# Temporary / backup files
# ------------------------------------------------------------
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------
*.log

# ------------------------------------------------------------
# Environment / secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example

*.jks
*.keystore
*.p12
*.pem

# ------------------------------------------------------------
# Flutter / Dart — nexrhythm_flutter
# ------------------------------------------------------------
nexrhythm_flutter/.dart_tool/
nexrhythm_flutter/.flutter-plugins
nexrhythm_flutter/.flutter-plugins-dependencies
nexrhythm_flutter/.packages
nexrhythm_flutter/.pub/
nexrhythm_flutter/.pub-cache/
nexrhythm_flutter/build/
nexrhythm_flutter/coverage/

# Keep these tracked for an application:
# nexrhythm_flutter/pubspec.lock
# nexrhythm_flutter/.metadata

# ------------------------------------------------------------
# Android generated/local files
# ------------------------------------------------------------
nexrhythm_flutter/android/.gradle/
nexrhythm_flutter/android/local.properties
nexrhythm_flutter/android/key.properties
nexrhythm_flutter/android/.cxx/
nexrhythm_flutter/android/app/.cxx/
nexrhythm_flutter/android/app/debug/
nexrhythm_flutter/android/app/profile/
nexrhythm_flutter/android/app/release/

# ------------------------------------------------------------
# Generated platform/plugin files
# ------------------------------------------------------------
nexrhythm_flutter/android/**/GeneratedPluginRegistrant.java

# Local development artifacts
temp/
patches/output/

# Local development artifacts
temp/
patches/output/
